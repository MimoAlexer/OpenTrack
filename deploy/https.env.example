# Pass with --env-file deploy/https.env.example for local HTTPS, then explicitly
# trust/export the local Caddy CA as documented. For an internet-facing hostname,
# copy this file, select that hostname, use port 443 and an explicit bind address.
OPENTRACK_DOMAIN=localhost
OPENTRACK_PUBLIC_URL=https://localhost:8443
OPENTRACK_HTTPS_PORT=8443
OPENTRACK_HTTPS_BIND_ADDRESS=127.0.0.1
# Change these together for concurrent projects or overlapping host routes.
# The dynamic range must be inside the subnet and exclude the proxy address.
OPENTRACK_PROXY_SUBNET=172.31.253.0/24
OPENTRACK_PROXY_DYNAMIC_RANGE=172.31.253.128/25
OPENTRACK_PROXY_ADDRESS=172.31.253.2
